{
	"ConnectionStrings": {
		"AppDbContext": ""
	},

	//#if (massTransitIntegration)
	"MessageBus": {
		"ASBConnectionString": ""
	},

	//#endif
	//#if (filesSupport)
	"BlobStorage": {
		"ConnectionString": "UseDevelopmentStorage=true",
		"Container": "files-store"
	},

	//#endif
