{
	"AllowedHosts": "*",

	"SSO": {
		"Authority": "http://localhost:8080/realms/monaco-template",
		"Audience": "monaco-template-backend"
	},

	"Observability": {
		"Signals": {
			"Traces": {
				"Enabled": true
			},
			"Metrics": {
				"Enabled": true
			},
			"Logs": {
				"Enabled": true
			}
		}
	},

	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft": "Warning",
			"System": "Warning",
			"Yarp": "Warning"
		}
	},

	"CorsPolicies": [
		{
			"Name": "Default",
			"Origins": [ "http://localhost:3000" ],
			"Headers": [ "Authorization" ],
			"Methods": [ "GET", "POST", "PUT", "DELETE", "OPTIONS" ]
		}
	]
}