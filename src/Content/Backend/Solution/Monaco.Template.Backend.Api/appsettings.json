{
	"AllowedHosts": "*",

	"ConnectionStrings": {
		"AppDbContext": ""
	},

	"CorsPolicies": [
		{
			"Name": "Default",
			"Origins": [ "http://localhost:4200" ],
			"Headers": [ "Authorization", "Content-Type" ],
			"Methods": [ "GET", "POST", "PUT", "DELETE", "OPTIONS" ]
		}
	],

	//#if (auth)
	"SSO": {
		"Authority": "http://localhost:8080/realms/monaco-template",
		"Audience": "monaco-template-api"
	},

	//#endif
	//#if (massTransitIntegration)
	"MessageBus": {
		"ASBConnectionString": ""
	},

	//#endif
	//#if (filesSupport)
	"BlobStorage": {
		"ConnectionString": "UseDevelopmentStorage=true",
		"Container": "files-store"
	},

	//#endif
	"Scalar": {
		"Title": "Monaco Template API",
		//#if (auth)
		"AuthEndpoint": "http://localhost:8080/realms/monaco-template/protocol/openid-connect/auth",
		"TokenEndpoint": "http://localhost:8080/realms/monaco-template/protocol/openid-connect/token",
		"ClientId": "monaco-template-api-scalar"
		//#endif
	},

	"Observability": {
		"Signals": {
			"Traces": { "Enabled": true },
			"Metrics": { "Enabled": true },
			"Logs": { "Enabled": true }
		},
		"SqlClient": { "QueryTextMode": "SanitizedText" },
		"Identity": { "Mode": "Subject" },
		"Shutdown": { "FlushTimeout": "00:00:05" }
	},

	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft": "Warning",
			"System": "Warning",
			"Microsoft.Hosting.Lifetime": "Information"
		}
	}
}