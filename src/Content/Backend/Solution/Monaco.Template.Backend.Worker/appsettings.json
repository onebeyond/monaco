		"Shutdown": { "FlushTimeout": "00:00:05" }
	},
	//#endif
	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft": "Warning",
			"System": "Warning",
			"Microsoft.Hosting.Lifetime": "Information"
		}
	}
}